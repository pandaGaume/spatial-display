{
  "name": "@spacexr/spatial-display-core",
  "version": "0.1.1",
  "description": "Renderer-agnostic contract and math for spatial displays: display interfaces and base classes, geometry of the frame of a surface and of its halo, image fitting, refresh scheduling.",
  "license": "Apache-2.0",
  "author": "Guillaume Pelletier (SpaceXR)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandaGaume/spatial-display.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/pandaGaume/spatial-display#readme",
  "bugs": {
    "url": "https://github.com/pandaGaume/spatial-display/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
