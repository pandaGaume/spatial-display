{
  "name": "@spacexr/spatial-display-babylon",
  "version": "0.1.2",
  "description": "Babylon.js displays: the view of any camera of any scene as a texture, on any mesh surface, and a portal on a rectangle, a cylinder or a mesh, with a frame, a light and a glow.",
  "license": "Apache-2.0",
  "author": "Guillaume Pelletier (SpaceXR)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pandaGaume/spatial-display.git",
    "directory": "packages/babylon"
  },
  "homepage": "https://github.com/pandaGaume/spatial-display#readme",
  "bugs": {
    "url": "https://github.com/pandaGaume/spatial-display/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@babylonjs/core": "^9.0.0",
    "@spacexr/spatial-display-core": "^0.1.2"
  },
  "devDependencies": {
    "@babylonjs/core": "9.33.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
